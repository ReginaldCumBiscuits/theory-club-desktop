{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theory Club",
  "version": "1.0.0",
  "identifier": "club.theory.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Theory Club",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Music theory, practice and online jamming",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRUY5RThGQjA4MkVBRTQKUldUazZvS3dqNTd2K3lnWXBLM2xKbXloUDBEbXZsVUFsUUd0MWtRRDJITEEzYTEzc05OMTJPWU0K",
      "endpoints": [
        "https://github.com/GITHUB_REPOSITORY/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}